# Placeholders only. Copy to .env (gitignored) and fill in locally.
# Values still starting with "your-" are treated as unset.
# Model provider: meterless (primary, uses METERLESS_*) or openai_compatible (uses MODEL_*).
LLM_PROVIDER=meterless
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.your-provider.example/v1
MODEL_NAME=your-model
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto
METERLESS_APP=agentoffice
# Only if used outside Nightshift; normally the NVIDIA key lives in Nightshift Providers.
NVIDIA_API_KEY=
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000
