# Placeholders only. Copy to .env (gitignored) and fill in locally.
# Values still starting with "your-" are treated as unset.
# Model provider: meterless (primary, uses METERLESS_*) or openai_compatible (uses MODEL_*).
LLM_PROVIDER=meterless
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.your-provider.example/v1
MODEL_NAME=your-model
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Or paste Nightshift's connect link (http://<host>:<port>/connect#k=<key>) instead of the two above.
METERLESS_CONNECT_LINK=
METERLESS_MODEL=meterless/auto
# Fast lane for light jobs and first drafts; "route" sends everything to METERLESS_MODEL.
METERLESS_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_FAST_THINKING=false
# Retried once if the provider answers 404 for the chosen model.
METERLESS_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
METERLESS_APP=agentoffice
# In Docker, localhost URLs above are rewritten to host.docker.internal automatically
# (Zetaris and Nightshift run on the host). Set this to true to keep them as written.
AGENTOFFICE_NO_HOST_REWRITE=false
# World Model store (SQLite); defaults to state/world.db.
WORLD_DB_PATH=
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000
