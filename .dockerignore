# `COPY . .` must never bake secrets or local state into the image.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.token
secrets/
credentials/
zetaris-platform/

# Version control, environments and caches
.git/
.gitignore
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime state, logs and user data (created fresh inside the container)
logs/*
!logs/.gitkeep
state/
uploads/
outputs/
island-browser/
*.log
*.db
*.sqlite
*.sqlite3

# Local tooling and scratch files
.claude/
.vscode/
.idea/
scratch/
tmp/
temp/
*.tmp
~$*
scripts/auto_push.ps1
.DS_Store
Thumbs.db
